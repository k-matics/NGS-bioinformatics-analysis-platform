# Copy to config/local.env (not in git) and adjust for this server.
# Read by scripts/start_services.sh and scripts/status.sh.

# Where run outputs are written (one folder per sample / run).
# NGS_RESULTS_DIR=/path/to/ngs_platform_results

# Folders whose files may be registered / browsed in the app (colon separated).
# NGS_DATA_ROOTS=/data:~

# GATK launcher (default: 'gatk' found on PATH).
# NGS_GATK_PATH=/opt/gatk-4.6.2.0/gatk
